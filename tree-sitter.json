{
  "grammars": [
    {
      "name": "jcl",
      "camelcase": "Jcl",
      "scope": "source.jcl",
      "path": ".",
      "file-types": [
        "jcl",
        "proc",
        "prc"
      ],
      "highlights": "queries/highlights.scm",
      "injection-regex": "^jcl$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "authors": [
      {
        "name": "Simon Peleska"
      }
    ]
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": true,
    "python": true,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
